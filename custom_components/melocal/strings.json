{
  "config": {
    "flow_title": "{name} ({host})",
    "step": {
      "user": {
        "title": "MELocal",
        "description": "Find Mitsubishi Electric MELCloud Wi-Fi adapters on your network and read them locally, without the cloud.",
        "menu_options": {
          "scan": "Scan the network",
          "manual": "Enter an IP address"
        }
      },
      "scan": {
        "title": "Scan the network",
        "description": "Networks to scan, comma separated (CIDR, e.g. 192.168.1.0/24). Adapters on another VLAN must be reachable from Home Assistant on TCP port 80.",
        "data": {
          "networks": "Networks"
        }
      },
      "pick": {
        "title": "Units found",
        "description": "Found {count} new unit(s). Choose the one to add now; the others will appear as discovered.",
        "data": {
          "mac": "Unit"
        }
      },
      "manual": {
        "title": "Add by IP address",
        "data": {
          "host": "IP address"
        }
      },
      "discovery_confirm": {
        "description": "Add {name} at {host}?"
      }
    },
    "error": {
      "invalid_networks": "Invalid network list (at most 4096 addresses in total).",
      "no_devices_found": "No adapter found.",
      "no_new_devices": "All the adapters found are already configured.",
      "cannot_connect": "No supported adapter answered at this address."
    },
    "abort": {
      "already_configured": "This unit is already configured (its IP address has been updated)."
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "scan_interval": "Polling interval (seconds)"
        }
      }
    }
  },
  "issues": {
    "controller_clock": {
      "title": "{name}: controller clock is off by {offset} minutes",
      "description": "The clock of the Ecodan controller differs from Home Assistant's time by {offset} minutes. This usually happens when daylight saving time starts or ends and the controller's summer-time setting is manual.\n\nOn the unit's main remote controller go to **Menu → Initial settings** and switch summer time on or off (or correct the date and time). This warning disappears by itself once the clock is right."
    }
  },
