{
  "config": {
    "flow_title": "{name} ({host})",
    "step": {
      "user": {
        "title": "MELocal",
        "description": "Trova gli adattatori Wi-Fi MELCloud di Mitsubishi Electric nella tua rete e leggili in locale, senza cloud.",
        "menu_options": {
          "scan": "Scansiona la rete",
          "manual": "Inserisci un indirizzo IP"
        }
      },
      "scan": {
        "title": "Scansiona la rete",
        "description": "Reti da scansionare, separate da virgola (CIDR, es. 192.168.1.0/24). Gli adattatori su un'altra VLAN devono essere raggiungibili da Home Assistant sulla porta TCP 80.",
        "data": {
          "networks": "Reti"
        }
      },
      "pick": {
        "title": "Unità trovate",
        "description": "Trovate {count} nuove unità. Scegli quella da aggiungere ora; le altre compariranno tra i dispositivi rilevati.",
        "data": {
          "mac": "Unità"
        }
      },
      "manual": {
        "title": "Aggiungi tramite IP",
        "data": {
          "host": "Indirizzo IP"
        }
      },
      "discovery_confirm": {
        "description": "Aggiungere {name} su {host}?"
      }
    },
    "error": {
      "invalid_networks": "Elenco di reti non valido (massimo 4096 indirizzi in totale).",
      "no_devices_found": "Nessun adattatore trovato.",
      "no_new_devices": "Tutti gli adattatori trovati sono già configurati.",
      "cannot_connect": "Nessun adattatore supportato risponde a questo indirizzo."
    },
    "abort": {
      "already_configured": "Questa unità è già configurata (il suo indirizzo IP è stato aggiornato)."
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "scan_interval": "Intervallo di aggiornamento (secondi)"
        }
      }
    }
  },
  "issues": {
    "controller_clock": {
      "title": "{name}: orologio del controller sfasato di {offset} minuti",
      "description": "L'orologio del controller Ecodan differisce dall'ora di Home Assistant di {offset} minuti. Di solito succede quando inizia o finisce l'ora legale e l'impostazione dell'ora legale del controller è manuale.\n\nSul comando principale dell'unità vai in **Menu → Impostazioni iniziali** e attiva o disattiva l'ora legale (oppure correggi data e ora). Questo avviso sparisce da solo quando l'ora è di nuovo corretta."
    }
  },
